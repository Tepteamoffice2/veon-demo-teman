---
// Line icons (24 grid, stroke = currentColor). Decorative: the accessible name is always on the link or button.
export type IconName = "phone" | "viber" | "telegram" | "whatsapp" | "cart" | "user" | "menu" | "close" | "arrow" | "pin" | "mail" | "facebook" | "instagram" | "youtube" | "tiktok" | "search";
interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />}
  {name === "viber" && (<>
    <path d="M12 2.6c-5 0-8.6 1.5-8.6 7.6 0 3.4 1.1 5.3 3.2 6.4v4.6l3.5-3.3c.6.05 1.2.07 1.9.07 5 0 8.6-1.5 8.6-7.6S17 2.6 12 2.6z" />
    <path d="M9.3 7.4c-.5.1-.9.6-.8 1.1.4 2.3 2.2 4.2 4.6 4.7.5.1 1-.3 1.1-.8l.1-.6-1.5-.8-.6.6c-.8-.3-1.5-1-1.8-1.8l.6-.6-.8-1.5z" />
    <path d="M13 6.4a3 3 0 0 1 2.6 2.6" />
  </>)}
  {name === "telegram" && (<>
    <path d="M21.2 3.6 2.9 10.6c-.8.3-.8 1.5.1 1.8l4.5 1.5 1.7 5.5c.3.8 1.3 1 1.9.4l2.5-2.4 4.6 3.4c.7.5 1.7.1 1.9-.7L22.6 5c.2-1-.6-1.8-1.4-1.4z" />
    <path d="m7.5 13.9 9.8-6.3-7.4 7.5" />
  </>)}
  {name === "whatsapp" && (<>
    <path d="M3.4 20.6 4.7 16.4A8.6 8.6 0 1 1 7.9 19.5z" />
    <path d="M9 8.6c0 3.4 3 6.4 6.4 6.4l.9-1.5-2-1-.9.8c-1-.4-2-1.4-2.4-2.4l.8-.9-1-2z" />
  </>)}
  {name === "cart" && (<>
    <circle cx="9" cy="20.5" r="1.2" /><circle cx="18" cy="20.5" r="1.2" />
    <path d="M2.5 3h2.2l2.5 12.2a1.8 1.8 0 0 0 1.8 1.4h8.8a1.8 1.8 0 0 0 1.8-1.4L21.3 7.5H5.6" />
  </>)}
  {name === "user" && (<><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></>)}
  {name === "menu" && <path d="M3 6h18M3 12h18M3 18h18" />}
  {name === "close" && <path d="M5 5l14 14M19 5 5 19" />}
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "search" && (<><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>)}
  {name === "pin" && (<><path d="M12 21.5s-7-6.3-7-11.5a7 7 0 0 1 14 0c0 5.2-7 11.5-7 11.5z" /><circle cx="12" cy="10" r="2.6" /></>)}
  {name === "mail" && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === "facebook" && <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H7v3.5h2V21h3.5v-8.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z" />}
  {name === "instagram" && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".6" /></>)}
  {name === "youtube" && (<><rect x="2" y="5" width="20" height="14" rx="4" /><path d="M10 9v6l5-3z" /></>)}
  {name === "tiktok" && <path d="M14 3v11.6a3.6 3.6 0 1 1-3.6-3.6M14 3c.3 2.7 2.2 4.7 5 4.9" />}
