---
// A future page that is not built in the demo yet (menu item, button, card, footer link).
// Renders an inactive element with a short note instead of a link: never point it to the client's current site.
// `align` keeps the note inside the screen near the edges.
interface Props { note?: string; class?: string; align?: "center" | "start" | "end"; label?: string; }
const { note = "Розділ у розробці", class: cls, align = "center", label } = Astro.props;
---
<span class:list={["future-link", `future-link--${align}`, cls]} role="link" aria-disabled="true" tabindex="0" aria-label={label ? `${label} (${note})` : undefined}>
  <slot />
  <span class="future-link__note" aria-hidden="true">{note}</span>
  {!label && <span class="visually-hidden">({note})</span>}
</span>
